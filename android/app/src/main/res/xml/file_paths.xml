<?xml version="1.0" encoding="utf-8"?>
<paths>
    <!-- Favorite wallpapers stored in the app-private files dir. -->
    <files-path name="favorites" path="favorites/" />
    <!-- Temp files for sharing / wallpaper set, in the evictable cache. -->
    <cache-path name="shared" path="shared/" />
    <!-- Crash logs written by the uncaught-exception handler. Shared only
         when the user explicitly taps "Share crash log". -->
    <cache-path name="crash" path="crash/" />
</paths>