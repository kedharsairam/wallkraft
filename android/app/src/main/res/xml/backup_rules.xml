<?xml version="1.0" encoding="utf-8"?>
<!-- Pre-Android 12 (API <= 30) auto-backup rules.
     The API key (EncryptedSharedPreferences) and settings DataStore must
     never leave the device. Favorites (Room) stay backed up. -->
<full-backup-content>
    <exclude domain="file" path="datastore/wallkraft_settings.preferences_pb" />
    <exclude domain="sharedpref" path="wallkraft_secure_prefs" />
    <exclude domain="sharedpref" path="wallkraft_fallback_prefs.xml" />
</full-backup-content>
