<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (API >= 31) data extraction rules.
     API key (EncryptedSharedPreferences) and settings DataStore must
     never leave the device; favorites (Room) may still back up. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/wallkraft_settings.preferences_pb" />
        <exclude domain="sharedpref" path="wallkraft_secure_prefs" />
        <exclude domain="sharedpref" path="wallkraft_fallback_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/wallkraft_settings.preferences_pb" />
        <exclude domain="sharedpref" path="wallkraft_secure_prefs" />
        <exclude domain="sharedpref" path="wallkraft_fallback_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
