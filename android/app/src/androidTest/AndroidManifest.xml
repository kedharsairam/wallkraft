<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Hilt 2.56 removed HiltTestRunner. Use HiltTestApplication with the
         default AndroidJUnitRunner instead (official migration path).
         tools:replace forces the test manifest's application to win over
         the main manifest's WallKraftApplication. -->
    <application
        android:name="dagger.hilt.android.testing.HiltTestApplication"
        tools:replace="android:name" />

</manifest>
