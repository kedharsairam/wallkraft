import { ListView, VerticalBox, HorizontalBox } from "std-widgets.slint";

// ---------------------------------------------------------------------------
// Kraft Design Language tokens (dark first). Ported from KraftTokens.kt.
// A global makes the palette available anywhere and easy to swap for light
// mode later: just set the properties from Rust.
// ---------------------------------------------------------------------------
global KraftTheme {
    in property <color> bg: #000000;
    in property <color> surface: #1C1C1E;
    in property <color> surface-secondary: #2C2C2E;
    in property <color> surface-tertiary: #3A3A3C;
    in property <color> text-primary: #FFFFFF;
    in property <color> text-secondary: #EBEBF5;
    in property <color> text-tertiary: #8E8E93;
    in property <color> accent: #0A84FF;
    in property <color> separator: #38383A;

    in property <length> radius-small: 8px;
    in property <length> radius-standard: 12px;
    in property <length> radius-large: 16px;

    in property <length> space-2: 8px;
    in property <length> space-3: 12px;
    in property <length> space-4: 16px;
    in property <length> space-5: 20px;
    in property <length> space-6: 24px;
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------
struct WallpaperData {
    id: string,
    thumb: image,
    resolution: string,
    category: string,
    // tile ratio = height / width, so a card height is width * ratio
    ratio: float,
}

struct RowData {
    left: WallpaperData,
    right: WallpaperData,
}

// ---------------------------------------------------------------------------
// Themed controls (custom-drawn, per Kraft design language)
// ---------------------------------------------------------------------------
component PrimaryButton inherits Rectangle {
    in property <string> text;
    callback clicked;

    height: 34px;
    border-radius: KraftTheme.radius-small;
    background: KraftTheme.accent;

    states [
        hovered when touch.has-hover: {
            background: #3395FF;
        }
        pressed when touch.pressed: {
            background: #006FE6;
        }
    ]

    HorizontalLayout {
        padding-left: 18px;
        padding-right: 18px;
        Text {
            text: root.text;
            color: #FFFFFF;
            font-size: 14px;
            font-weight: 600;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
        mouse-cursor: pointer;
    }
}

component GhostButton inherits Rectangle {
    in property <string> text;
    callback clicked;

    height: 34px;
    border-radius: KraftTheme.radius-small;
    background: KraftTheme.surface-secondary;

    states [
        hovered when touch.has-hover: {
            background: KraftTheme.surface-tertiary;
        }
    ]

    HorizontalLayout {
        padding-left: 18px;
        padding-right: 18px;
        Text {
            text: root.text;
            color: KraftTheme.text-primary;
            font-size: 14px;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
        mouse-cursor: pointer;
    }
}

// ---------------------------------------------------------------------------
// Wallpaper tile
// ---------------------------------------------------------------------------
component WallpaperCard inherits Rectangle {
    in property <WallpaperData> data;
    callback clicked;

    visible: root.data.id != "";
    background: KraftTheme.surface-secondary;
    border-radius: KraftTheme.radius-standard;
    clip: true;

    states [
        hovered when touch.has-hover: {
            background: KraftTheme.surface-tertiary;
        }
    ]

    Image {
        source: root.data.thumb;
        width: 100%;
        height: 100%;
        image-fit: cover;
    }

    // resolution pill
    Rectangle {
        x: 8px;
        y: 8px;
        height: 20px;
        border-radius: 10px;
        background: #00000080;
        HorizontalLayout {
            padding-left: 8px;
            padding-right: 8px;
            Text {
                text: root.data.resolution;
                color: #FFFFFF;
                font-size: 11px;
                vertical-alignment: center;
            }
        }
    }

    // subtle hover veil
    Rectangle {
        width: 100%;
        height: 100%;
        background: #FFFFFF12;
        visible: touch.has-hover;
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
        mouse-cursor: pointer;
    }
}

// ---------------------------------------------------------------------------
// Placeholder tile while the first page loads
// ---------------------------------------------------------------------------
component ShimmerTile inherits Rectangle {
    height: 180px;
    border-radius: KraftTheme.radius-standard;
    background: KraftTheme.surface-secondary;
    opacity: 0.5;
    animate opacity { duration: 1.4s; iteration-count: -1; }
}

// ---------------------------------------------------------------------------
// Main window
// ---------------------------------------------------------------------------
export component MainWindow inherits Window {
    title: "WallKraft";
    width: 1100px;
    height: 720px;
    background: KraftTheme.bg;

    in property <[RowData]> rows: [];
    in property <bool> loading: false;
    in property <string> status: "";
    in property <bool> detail-visible: false;
    in property <image> detail-image;
    in property <string> detail-resolution: "";
    in property <string> detail-id: "";

    callback search(string);
    callback load-more();
    callback open-detail(string);
    callback set-wallpaper(string);
    callback open-wallhaven(string);
    callback close-detail();

    VerticalBox {
        padding: KraftTheme.space-4;
        spacing: KraftTheme.space-3;

        // Header
        HorizontalBox {
            spacing: KraftTheme.space-3;

            Text {
                text: "WallKraft";
                font-size: 24px;
                font-weight: 700;
                color: KraftTheme.text-primary;
                vertical-alignment: center;
            }

            // Search field
            Rectangle {
                horizontal-stretch: 1;
                height: 34px;
                border-radius: KraftTheme.radius-small;
                background: KraftTheme.surface-secondary;

                states [
                    focused when search-field.has-focus: {
                        background: KraftTheme.surface-tertiary;
                    }
                ]

                // Placeholder layer (TextInput has no built-in placeholder)
                Text {
                    x: 12px;
                    width: parent.width - 24px;
                    height: 100%;
                    text: "Search wallpapers";
                    color: KraftTheme.text-tertiary;
                    font-size: 14px;
                    vertical-alignment: center;
                    visible: search-field.text == "" && !search-field.has-focus;
                }

                search-field := TextInput {
                    x: 12px;
                    width: parent.width - 24px;
                    height: 100%;
                    color: KraftTheme.text-primary;
                    font-size: 14px;
                    vertical-alignment: center;
                    accepted => { root.search(self.text); }
                }
            }

            PrimaryButton {
                text: "Search";
                clicked => { root.search(search-field.text); }
            }
        }

        // First-load skeleton
        if root.loading && root.rows.length == 0: VerticalLayout {
            spacing: KraftTheme.space-3;
            for i in 4: HorizontalLayout {
                spacing: KraftTheme.space-3;
                ShimmerTile { }
                ShimmerTile { }
            }
        }

        // Grid
        ListView {
            for row in root.rows: HorizontalLayout {
                spacing: KraftTheme.space-3;
                WallpaperCard {
                    data: row.left;
                    vertical-stretch: 0;
                    height: self.width * row.left.ratio;
                    clicked => { root.open-detail(row.left.id); }
                }
                WallpaperCard {
                    data: row.right;
                    vertical-stretch: 0;
                    height: self.width * row.right.ratio;
                    clicked => { root.open-detail(row.right.id); }
                }
            }

            // Infinite scroll: load more when the viewport nears the bottom
            changed viewport-y => {
                if self.viewport-y + self.visible-height >= self.viewport-height - 400px {
                    root.load-more();
                }
            }
        }

        // Footer hint / load state
        HorizontalBox {
            height: 28px;
            Rectangle { }
            if root.loading && root.rows.length > 0: Text {
                text: "Loading more...";
                color: KraftTheme.text-tertiary;
                font-size: 12px;
                vertical-alignment: center;
            }
        }
    }

    // -----------------------------------------------------------------------
    // Detail overlay
    // -----------------------------------------------------------------------
    if root.detail-visible: Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        background: KraftTheme.bg;

        VerticalBox {
            padding: KraftTheme.space-4;
            spacing: KraftTheme.space-3;

            HorizontalBox {
                spacing: KraftTheme.space-2;
                GhostButton {
                    text: "Back";
                    clicked => { root.close-detail(); }
                }
                Text {
                    text: root.detail-id;
                    color: KraftTheme.text-tertiary;
                    font-size: 13px;
                    vertical-alignment: center;
                }
                Rectangle { }
                Text {
                    text: root.detail-resolution;
                    color: KraftTheme.text-tertiary;
                    font-size: 13px;
                    vertical-alignment: center;
                }
            }

            Image {
                horizontal-stretch: 1;
                vertical-stretch: 1;
                source: root.detail-image;
                image-fit: contain;
            }

            HorizontalBox {
                spacing: KraftTheme.space-3;
                PrimaryButton {
                    text: "Set as Wallpaper";
                    clicked => { root.set-wallpaper(root.detail-id); }
                }
                GhostButton {
                    text: "Open on wallhaven.cc";
                    clicked => { root.open-wallhaven(root.detail-id); }
                }
            }
        }
    }

    // -----------------------------------------------------------------------
    // Status toast
    // -----------------------------------------------------------------------
    if root.status != "": Rectangle {
        x: (parent.width - self.width) / 2;
        y: parent.height - self.height - 28px;
        height: 36px;
        border-radius: 18px;
        background: #1C1C1ECC;
        HorizontalLayout {
            padding-left: 16px;
            padding-right: 16px;
            Text {
                text: root.status;
                color: KraftTheme.text-primary;
                font-size: 13px;
                vertical-alignment: center;
            }
        }
    }
}